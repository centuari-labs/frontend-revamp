# Template env file untuk script deploy-local.sh
#
# Copy file ini ke .env.<env>.build (akan di-gitignore):
#   cp .env.build.example .env.dev.build
#   cp .env.build.example .env.staging.build
#   cp .env.build.example .env.prod.build
#
# Lalu edit tiap file dengan value sesuai environment-nya.
#
# Variables ini akan di-bake ke Next.js build sebagai NEXT_PUBLIC_* vars.
# Karena jadi bagian dari client bundle, JANGAN simpan secret di sini.

# ─── Privy ───────────────────────────────────────────────────────────────────
# App ID dari https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=

# ─── Backend WebSocket URL ───────────────────────────────────────────────────
# dev:     https://dev-api.centuari.example
# staging: https://staging-api.centuari.example
# prod:    https://api.centuari.example
NEXT_PUBLIC_WS_URL=

# ─── Chain Environment ───────────────────────────────────────────────────────
# testnet (dev/staging) atau mainnet (prod)
NEXT_PUBLIC_CHAIN_ENV=testnet

# ─── Mock Mode ───────────────────────────────────────────────────────────────
# false untuk pakai backend asli, true untuk localStorage mock (dev only)
NEXT_PUBLIC_USE_MOCK=false

# ─── Custom RPC URL (optional) ───────────────────────────────────────────────
# Kosongkan untuk pakai public RPC
# Untuk prod, isi dengan Alchemy/Infura URL
NEXT_PUBLIC_RPC_URL=

# ─── Hub Depositor Contract Address ──────────────────────────────────────────
NEXT_PUBLIC_HUB_DEPOSITOR_ADDRESS=0x122ea513fE68d78CdAD06F982237B1b67a335439
