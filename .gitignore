# env files (can opt-in for committing if needed)
.env
.env.*.build

# Auto-generated by smart-contract-revamp/bin/sync-to-services.sh
.env.local
/abis/*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.tspackage-lock.json

test-results

playwright-report

# Captured Privy sessions for e2e — never commit (real auth tokens)
e2e/.auth/*
!e2e/.auth/.gitkeep
!e2e/.auth/README.md