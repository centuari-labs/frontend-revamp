# ─── Server ──────────────────────────────────────────────────────────
PORT=3200                                    # Next.js dev server port
BACKEND_URL=http://localhost:3000            # Backend API (server-side proxy target)

# ─── Auth (Privy) ────────────────────────────────────────────────────
NEXT_PUBLIC_PRIVY_APP_ID=

# ─── WebSocket ───────────────────────────────────────────────────────
NEXT_PUBLIC_WS_URL=http://localhost:3000     # Socket.IO server URL (client-side)

# ─── Chain ──────────────────────────────────────────────────────────
NEXT_PUBLIC_CHAIN_ENV=testnet                # "mainnet" = Arbitrum, anything else = Arbitrum Sepolia

# ─── Feature Flags ───────────────────────────────────────────────────
NEXT_PUBLIC_USE_MOCK=false                   # true = localStorage mock data, false = real backend API

# ─── RPC ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_RPC_URL=                          # Custom RPC URL (Alchemy, Infura, etc.). Falls back to public RPC if empty.

# ─── Contracts ────────────────────────────────────────────────────────
# Note: addresses are normally auto-managed in .env.local by
#   smart-contract-revamp/bin/sync-to-services.sh. These entries only
#   apply if you copy this file to .env (manual override).
NEXT_PUBLIC_HUB_DEPOSITOR_ADDRESS=             # HubDepositor contract address (for deposits)
NEXT_PUBLIC_COLLATERAL_MANAGER_ADDRESS=        # CollateralManager proxy address (for emergency on-chain flag via wagmi)
