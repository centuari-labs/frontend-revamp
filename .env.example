# ─── Server ──────────────────────────────────────────────────────────
PORT=3200                                    # Next.js dev server port
BACKEND_URL=http://localhost:3000            # Backend API (server-side proxy target)

# ─── Auth (Privy) ────────────────────────────────────────────────────
# Required (throws at import if empty). Mainnet and testnet use SEPARATE
# Privy apps — in prod set the mainnet app id, and it MUST equal backend-v2's
# PRIVY_APP_ID (the backend verifies the token this app mints).
NEXT_PUBLIC_PRIVY_APP_ID=

# ─── WebSocket ───────────────────────────────────────────────────────
NEXT_PUBLIC_WS_URL=http://localhost:3000     # Socket.IO server URL (client-side)

# ─── Chain ──────────────────────────────────────────────────────────
# "mainnet" = Arbitrum One (42161), "testnet" = Arbitrum Sepolia (421614).
# Unset is allowed in dev/test (defaults to testnet) but a PRODUCTION build
# throws unless this is set explicitly — no silent testnet fallback in prod.
NEXT_PUBLIC_CHAIN_ENV=testnet

# ─── Mainnet (prod) example ──────────────────────────────────────────
# NEXT_PUBLIC_CHAIN_ENV=mainnet
# NEXT_PUBLIC_PRIVY_APP_ID=<mainnet-privy-app-id>   # must match backend PRIVY_APP_ID
# NEXT_PUBLIC_RPC_URL=<arbitrum-one-rpc-url>        # e.g. Alchemy/Infura Arbitrum One
# Contract addresses still come from .env.local via sync-to-services.sh against a mainnet deploy.

# ─── Feature Flags ───────────────────────────────────────────────────
NEXT_PUBLIC_USE_MOCK=false                   # true = localStorage mock data, false = real backend API

# ─── RPC ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_RPC_URL=                          # Custom RPC URL (Alchemy, Infura, etc.). Falls back to public RPC if empty.

# ─── Contract Addresses ──────────────────────────────────────────────
# Contract addresses are auto-managed in .env.local by
# smart-contract-revamp/bin/sync-to-services.sh — do not declare them here.
