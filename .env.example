# ─── Server ──────────────────────────────────────────────────────────
PORT=3200                                    # Next.js dev server port
BACKEND_URL=http://localhost:3000            # Backend API (server-side proxy target)

# ─── Auth (Privy) ────────────────────────────────────────────────────
NEXT_PUBLIC_PRIVY_APP_ID=
# NOTE: NODE_ENV controls auth mode (set automatically by Next.js):
#   next dev   → NODE_ENV=development → sends DEV_TOKEN_<wallet> (backend must also be in dev mode)
#   next build → NODE_ENV=production  → sends real Privy JWT (backend must use PrivyAuthStrategy)

# ─── WebSocket ───────────────────────────────────────────────────────
NEXT_PUBLIC_WS_URL=http://localhost:3000     # Socket.IO server URL (client-side)

# ─── Feature Flags ───────────────────────────────────────────────────
NEXT_PUBLIC_USE_MOCK=false                   # true = localStorage mock data, false = real backend API
